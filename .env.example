# Copie ce fichier en .env, puis remplis tes propres valeurs.
# cp .env.example .env

# IP/port de Moonraker (souvent 127.0.0.1:7125 si Klipper tourne sur la
# même machine que ce conteneur, sinon l'IP LAN de ta machine Klipper)
MOONRAKER_HOST=192.168.1.100
MOONRAKER_PORT=7125

# IP/port du flux webcam (Crowsnest, MJPG-streamer, etc.)
WEBCAM_HOST=192.168.1.100
WEBCAM_PORT=8080

# Ports publiés côté hôte — ceux que ton reverse proxy doit cibler
FLUIDD_REMOTE_PORT=8090
MAINSAIL_REMOTE_PORT=8091

# Compte admin créé automatiquement au tout premier démarrage
AUTH_USER=admin
AUTH_PASSWORD=changeme

# "https" si ce conteneur est derrière un reverse proxy TLS (recommandé)
# "http" uniquement en test local sans TLS devant
CONNECTION_TYPE=https

# Bannissement automatique d'IP après échecs de connexion répétés
BAN_THRESHOLD=3
BAN_DURATION_MINUTES=60
